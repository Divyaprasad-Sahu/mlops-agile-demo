{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Experiment 1: Train Iris model",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "src.iris_demo", "train"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Experiment 1: Predict sample flower",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "src.iris_demo", "predict", "5.1", "3.5", "1.4", "0.2"],
      "options": {"cwd": "${workspaceFolder}"},
      "dependsOn": "Experiment 1: Train Iris model",
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Experiment 1: Run automated tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "-q", "--junitxml=reports/junit.xml"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Experiment 1: Show Git history",
      "type": "process",
      "command": "git",
      "args": ["log", "--oneline", "--graph", "--all"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    }
  ]
}
